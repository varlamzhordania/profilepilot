rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access to prevent unauthorized reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // User Credit Accounts: users can ONLY read their own balance; writes are server-only
    match /creditAccounts/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Razorpay Orders: users can ONLY read their own orders; writes are server-only
    match /razorpayOrders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Credit Transactions Audit Log: users can ONLY read their own transactions; writes are server-only
    match /creditTransactions/{transactionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Basic User Profile: users can read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
