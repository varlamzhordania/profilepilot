# ==============================================================================
# Application & Database Configuration
# ==============================================================================

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIRESTORE_DATABASE_ID: The ID of the Firebase / Firestore database
FIRESTORE_DATABASE_ID=

# ==============================================================================
# AI Services
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# Payment Gateway: Razorpay
# ==============================================================================

# Public client / key IDs for frontend and server
RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Secret key for verifying Razorpay HMAC signatures (backend only)
RAZORPAY_KEY_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Secret key for verifying Razorpay webhook API signatures
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# Payment Gateway: PayPal
# ==============================================================================

# PAYPAL_MODE: Set to "sandbox" for testing or "live" for production
PAYPAL_MODE=sandbox

# Public client IDs for frontend and server
PAYPAL_CLIENT_ID=
VITE_PAYPAL_CLIENT_ID=

# PAYPAL_CLIENT_SECRET: PayPal client secret (backend only)
PAYPAL_CLIENT_SECRET=